<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/titulo_lab"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_chiste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_chiste" />

    <Button
        android:id="@+id/btn_calificar_taller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_calificar_taller" />

    <Button
        android:id="@+id/btn_entregar_tarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_entregar_tarea" />

</LinearLayout>
